<Project>
    <!-- Inherit build settings from the parent Directory.Build.props file. -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    </PropertyGroup>

    <!-- Shared test tooling for every Tests/* project. -->
    <ItemGroup>
        <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
        <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(ProwlSampleTargetFramework)</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <OutputType>Library</OutputType>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Prowl.Graphite.Rendering</PackageId>
        <Description>The high level renderer of Prowl.Graphite: worlds, meshes, materials, views and the frame pipeline.</Description>
        <PackageTags>graphics renderer vulkan bindless</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Graphite\Prowl.Graphite.csproj" />
        <ProjectReference Include="..\ShaderDef\Core\Prowl.Graphite.ShaderDef.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Library\**\*.glsl" LogicalName="Graphite/%(RecursiveDir)%(Filename)%(Extension)" />
        <EmbeddedResource Include="Library\**\*.shader" LogicalName="Graphite/%(RecursiveDir)%(Filename)%(Extension)" />
        <EmbeddedResource Include="Library\Data\*.bin" LogicalName="Graphite/Data/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Prowl.Graphite.Rendering.Tests" />
    </ItemGroup>
</Project>

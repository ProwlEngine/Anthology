<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>DebuggerViewer</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Shared/Shared.csproj" />
        <ProjectReference Include="../../Debugger/Viewer/Prowl.Graphite.Debugger.Viewer.csproj" />
        <ProjectReference Include="../PBRRenderer/PBRRenderer.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Fonts\**\*.ttf" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Shaders\**\*.shader" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(ProwlSampleTargetFramework)</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <OutputType>Library</OutputType>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Prowl.Graphite.ShaderDef.Compiler</PackageId>
        <Description>The GLSL shader compiler for Prowl.Graphite.ShaderDef, built on Prism.</Description>
        <PackageTags>graphics api Vulkan glsl spirv compiler shader</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Graphite\Prowl.Graphite.csproj" />
        <ProjectReference Include="..\Core\Prowl.Graphite.ShaderDef.csproj" />
        <ProjectReference Include="..\..\..\Prism\Prism\Prowl.Prism.csproj" />
    </ItemGroup>


    <ItemGroup>
        <EmbeddedResource Include="Library\**\*.glsl" LogicalName="Graphite/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Prowl.Graphite.ShaderDef.Compiler.Tests" />
        <InternalsVisibleTo Include="Prowl.Graphite.ShaderDef.Tests" />
    </ItemGroup>
</Project>

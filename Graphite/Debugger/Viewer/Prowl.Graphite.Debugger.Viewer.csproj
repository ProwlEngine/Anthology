<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <OutputType>Library</OutputType>
        <RootNamespace>Prowl.Graphite.Debugger.Viewer</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Prowl.Graphite.Debugger.Viewer</PackageId>
        <Description>Viewer and render profiler UI for Graphite debugger recordings.</Description>
        <PackageTags>Graphics Vulkan Debugger Viewer Profiler</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Prowl.Graphite.Debugger.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Prowl.Graphite.Debugger.csproj" />
        <ProjectReference Include="..\..\Graphite\Prowl.Graphite.csproj" />
        <ProjectReference Include="..\..\Rendering\Prowl.Graphite.Rendering.csproj" />
        <ProjectReference Include="..\..\..\Origami\Origami\Origami.csproj" />
        <ProjectReference Include="..\..\..\Paper\Paper\Paper.csproj" />
        <ProjectReference Include="..\..\..\Quill\Quill\Quill.csproj" />
    </ItemGroup>

</Project>

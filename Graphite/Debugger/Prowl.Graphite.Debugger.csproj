<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <OutputType>Library</OutputType>
        <RootNamespace>Prowl.Graphite.Debugger</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Prowl.Graphite.Debugger</PackageId>
        <Description>Records Graphite graph executions into a serializable trace and replays them down to a single GPU event, with a viewer and render profiler UI.</Description>
        <PackageTags>Graphics Vulkan Debugger Capture Replay</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Prowl.Graphite.Debugger.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Graphite\Prowl.Graphite.csproj" />
        <ProjectReference Include="..\..\Echo\Echo\Echo.csproj" />
        <ProjectReference Include="..\Rendering\Prowl.Graphite.Rendering.csproj" />
        <ProjectReference Include="..\..\Origami\Origami\Origami.csproj" />
        <ProjectReference Include="..\..\Paper\Paper\Paper.csproj" />
        <ProjectReference Include="..\..\Quill\Quill\Quill.csproj" />
    </ItemGroup>

</Project>

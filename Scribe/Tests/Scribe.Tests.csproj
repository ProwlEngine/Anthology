<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(ProwlTestTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scribe\Scribe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse existing sample fonts to build portable TTC fixtures in memory. -->
    <EmbeddedResource Include="..\..\Origami\Samples\OpenTK\Fonts\Geist-Regular.ttf" LogicalName="Geist-Regular.ttf" />
    <EmbeddedResource Include="..\..\Origami\Samples\OpenTK\Fonts\Geist-Bold.ttf" LogicalName="Geist-Bold.ttf" />
  </ItemGroup>

</Project>
